# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env
# Секреты генерируются командой:  openssl rand -hex 32
# Или просто запустите ./install.sh — он создаст .env сам.

WEBUI_SECRET_KEY=
OPEN_TERMINAL_API_KEY=
WEBUI_URL=http://localhost:3000
SEARXNG_BASE_URL=http://localhost:8080
OLLAMA_BASE_URL=http://host.docker.internal:11434
ENABLE_SIGNUP=true
GLOBAL_LOG_LEVEL=INFO
AIOHTTP_CLIENT_TIMEOUT=900
AIOHTTP_CLIENT_STREAM_IDLE_TIMEOUT=600
DATA_VOLUME=open-webui
PORT=3000
